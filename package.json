{
  "name": "keel-account-service",
  "version": "0.1.0",
  "description": "Keel account service: AI proxy, Sign in with Apple, usage ledger",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "migrate": "node dist/cli/migrate.js",
    "migrate:dev": "tsx src/cli/migrate.ts",
    "config": "tsx src/cli/config.ts",
    "tool-hash": "tsx src/cli/tool-hash.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.3.0",
    "@hono/node-server": "^2.1.5",
    "hono": "^4.13.14",
    "jose": "^6.2.14",
    "postgres": "^4.0.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  },
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  }
}
