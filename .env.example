# Copy to .env for local development. In production these are Fly secrets:
#   fly secrets set ANTHROPIC_API_KEY=... ACCESS_TOKEN_SECRET=... PROJECT_HASH_SALT=... APPLE_CLIENT_ID=...
# DATABASE_URL is set by `fly postgres attach` (or paste a Neon URL).
DATABASE_URL=postgres://postgres@127.0.0.1:5432/keel
ANTHROPIC_API_KEY=sk-ant-...          # key from Keel's dedicated Anthropic workspace
ACCESS_TOKEN_SECRET=                  # openssl rand -hex 32
PROJECT_HASH_SALT=                    # openssl rand -hex 16; never change it once set
APPLE_CLIENT_ID=app.keel.mac          # the Mac app's bundle id (placeholder)
APP_ATTEST_MODE=off
PORT=8080
