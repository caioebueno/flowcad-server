# Copy to .env for local development. In production these are Railway service
# variables. DATABASE_URL should reference the Railway Postgres service:
#   DATABASE_URL=${{Postgres.DATABASE_URL}}
# PORT is set by Railway; leave it unset there.
DATABASE_URL=postgres://postgres@127.0.0.1:5432/keel
ANTHROPIC_API_KEY=sk-ant-...          # key from Keel's dedicated Anthropic workspace
ACCESS_TOKEN_SECRET=                  # openssl rand -hex 32
PROJECT_HASH_SALT=                    # openssl rand -hex 16; never change it once set
APPLE_CLIENT_ID=app.keel.mac          # the Mac app's bundle id (placeholder)
PUBLIC_BASE_URL=http://localhost:8080 # the public https address in production
RESEND_API_KEY=                       # sign-in emails; leave empty locally to print codes to the log
EMAIL_FROM=Keel <signin@keel.app>
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...       # `stripe listen --forward-to localhost:8080/v1/billing/stripe/webhook` prints one
STRIPE_PRICE_MONTH=price_...
STRIPE_PRICE_YEAR=price_...
STRIPE_AUTOMATIC_TAX=false
APP_ATTEST_MODE=off
PORT=8080
